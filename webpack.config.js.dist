const { ROOT_PATH, HEADER_TITLE } = require('./src/client_settings')
const webpack = require('webpack')
const path = require('path')
const CopyPlugin = require('copy-webpack-plugin')
const HtmlWebpackPlugin = require('html-webpack-plugin')
const MiniCssExtractPlugin = require('mini-css-extract-plugin')

module.exports = {
  devtool: 'source-map',
  devServer: {
    port: 8080,
    static: './dist',
    historyApiFallback: {
      disableDotRule: true,
      index: ROOT_PATH
    }
    // When running the dev server against a containerized sealog-server on port
    // 8000, enable this proxy block to avoid CORS issues. Also set SERVER_PORT
    // to 8080 in client_settings.js so API URLs route through the dev server.
    // Remove for production builds served by nginx.
    // proxy: [
    //   {
    //     context: ['/sealog-server', '/ws', '/files'],
    //     target: 'http://localhost:8000',
    //     ws: true
    //   }
    // ],
    // client: {
    //   webSocketURL: 'ws://localhost:8080/webpack-hmr'
    // },
    // webSocketServer: {
    //   options: {
    //     path: '/webpack-hmr'
    //   }
    // }
  },
  output: {
    path: path.resolve(__dirname, 'dist'),
    filename: 'js/[name].[contenthash].js',
    publicPath: ROOT_PATH,
    clean: true
  },
  optimization: {
    splitChunks: {
      chunks: 'all',
      cacheGroups: {
        moment: {
          test: /[\\/]node_modules[\\/](moment)/, // Target only the 'moment' library
          name: 'moment', // Name of the output file (moment.[contenthash].js)
          chunks: 'all', // Apply to both dynamic and static imports
          priority: 10 // Higher priority to ensure moment is separated first
        },
        leaflet: {
          test: /[\\/]node_modules[\\/](leaflet)/, // Target only the 'leaflet' library
          name: 'leaflet', // Name of the output file (leaflet.[contenthash].js)
          chunks: 'all', // Apply to both dynamic and static imports
          priority: 10 // Higher priority to ensure leaflet is separated first
        },
        filepond: {
          test: /[\\/]node_modules[\\/](filepond)/, // Target only the 'filepond' library
          name: 'filepond', // Name of the output file (filepond.[contenthash].js)
          chunks: 'all', // Apply to both dynamic and static imports
          priority: 10 // Higher priority to ensure filepond is separated first
        }
      }
    },
    runtimeChunk: 'single'
  },
  module: {
    rules: [
      {
        test: /\.(js|jsx)$/,
        exclude: /node_modules/,
        use: {
          loader: 'babel-loader'
        }
      },
      {
        test: /\.css$/,
        use: [MiniCssExtractPlugin.loader, 'css-loader']
      },
      {
        test: /\.s[ac]ss$/i,
        use: [
          process.env.NODE_ENV !== 'production' ? 'style-loader' : MiniCssExtractPlugin.loader,
          {
            loader: 'css-loader',
            options: {
              sourceMap: true
            }
          },
          {
            loader: 'sass-loader',
            options: {
              api: 'modern',
              sourceMap: true,
              sassOptions: {
                quietDeps: true,
                silenceDeprecations: ['import', 'color-functions', 'global-builtin']
              }
            }
          }
        ]
      },
      {
        test: /\.woff(2)?(\?v=[0-9]\.[0-9]\.[0-9])?$/,
        type: 'asset/resource',
        generator: {
          filename: 'fonts/[hash][ext][query]'
        }
      },
      {
        test: /\.(png|jpg|jpeg)$/,
        type: 'asset/resource',
        generator: {
          filename: 'images/[hash][ext]'
        }
      },
      {
        test: /\.(ttf|eot|svg)(\?v=[0-9]\.[0-9]\.[0-9])?$/,
        type: 'asset/resource',
        generator: {
          filename: 'fonts/[hash][ext][query]'
        }
      }
    ]
  },
  plugins: [
    new webpack.ProvidePlugin({
      process: 'process/browser'
    }),
    new HtmlWebpackPlugin({
      title: HEADER_TITLE,
      template: './src/assets/index.html',
      favicon: './src/assets/images/favicon.ico'
    }),
    new MiniCssExtractPlugin({
      filename: 'style/[[name].[contenthash].css'
    }),
    new CopyPlugin({
      patterns: [{ from: path.resolve(__dirname, 'src/assets/images/'), to: 'images' }]
    })
  ],
  performance: {
    hints: false
  },
  resolve: {
    fallback: {
      'process/browser': require.resolve('process/browser')
    }
  }
}
